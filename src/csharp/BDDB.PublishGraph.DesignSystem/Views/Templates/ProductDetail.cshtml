@model PageViewModel
@{ var data = (ProductDetailTemplateData)Model.Page.TemplateData; }
<article class="container stack template-page template-page--product-detail">
  @await Html.PartialAsync("_PageHeading", new PageHeadingModel(Model.Page.Eyebrow ?? "Private synthetic capability contract", Model.Page.Title, Model.Page.Description))
  @await Html.PartialAsync("_Hero", new HeroModel(data.Product.Summary,
    data.Media is null ? null : new MediaFrameModel(data.Media.AssetId, MediaAspectRatio.Landscape16x9, data.Media.Alt, data.Media.Caption, data.Media.Credit, data.Media.State,
      data.Media.State == "available" ? AssetRoute.For(Model.AssetNamespace, data.Media.AssetId) : null), []))
  @await Html.PartialAsync("_Blocks", new BlocksModel(Model.Page.Blocks, "afterHero", Model.AssetNamespace))
  @await Html.PartialAsync("_Capabilities", new CapabilitiesModel(data.Product, data.Capabilities))
  @await Html.PartialAsync("_MarkdownBody", new MarkdownBodyModel(Model.Html))
  @await Html.PartialAsync("_Blocks", new BlocksModel(Model.Page.Blocks, "afterBody", Model.AssetNamespace))
</article>
