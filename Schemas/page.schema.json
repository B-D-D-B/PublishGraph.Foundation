{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sda.test/page-v1.json",
  "title": "SDA content page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "title", "description", "route", "template", "color_palette", "header_style", "footer_style", "components", "published", "visibility", "status", "order", "dependencies", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "kind": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "route": { "type": "string", "pattern": "^/$|^/(?:[a-z0-9]+(?:-[a-z0-9]+)*/)+$" },
    "template": { "enum": ["full-width", "hero-left", "sidebar", "card-grid", "article", "product-detail"] },
    "color_palette": { "enum": ["paper", "navy", "ember"] },
    "header_style": { "enum": ["standard", "compact", "minimal"] },
    "footer_style": { "enum": ["standard", "minimal"] },
    "hero_image": { "type": ["string", "null"] },
    "eyebrow": { "type": ["string", "null"] },
    "hero_summary": { "type": ["string", "null"] },
    "hero_actions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["page_id", "text"],
        "properties": {
          "page_id": { "type": "string" }, "text": { "type": "string", "minLength": 1 },
          "variant": { "enum": ["primary", "secondary", "quiet"] }
        }
      }
    },
    "related_pages": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "collection_pages": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "attribution": { "type": ["string", "null"] },
    "source_date": { "type": ["string", "null"], "format": "date" },
    "source_date_unknown": { "type": "boolean" },
    "product_id": { "type": ["string", "null"] },
    "components": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "slot", "data"],
        "properties": {
          "id": { "enum": ["notice", "media", "feed-fallback", "callout", "status"] },
          "slot": { "enum": ["beforeBody", "afterHero", "sidebar", "beforeGrid", "afterBody"] },
          "data": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "published": { "type": "boolean" },
    "visibility": { "enum": ["public", "private-preview", "private"] },
    "status": { "enum": ["draft", "approved", "archived", "superseded"] },
    "public_archive_label": { "type": ["string", "null"] },
    "order": { "type": "integer" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array" }
  },
  "allOf": [
    { "if": { "properties": { "template": { "const": "hero-left" } } }, "then": { "required": ["hero_summary"] } },
    { "if": { "properties": { "template": { "const": "sidebar" } } }, "then": { "required": ["related_pages"] } },
    { "if": { "properties": { "template": { "const": "card-grid" } } }, "then": { "required": ["collection_pages"] } },
    { "if": { "properties": { "template": { "const": "article" } } }, "then": { "required": ["attribution"], "anyOf": [{ "required": ["source_date"] }, { "required": ["source_date_unknown"] }] } },
    { "if": { "properties": { "template": { "const": "product-detail" } } }, "then": { "required": ["product_id"] } }
  ]
}
