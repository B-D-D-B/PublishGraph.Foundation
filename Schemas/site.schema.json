{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sda.test/site-v1.json",
  "title": "SDA site configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "siteId", "name", "baseUrl", "defaultPalette", "assetNamespace", "hostnames", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "siteId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "defaultPalette": { "enum": ["paper", "navy", "ember"] },
    "assetNamespace": { "type": "string" },
    "hostnames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "assets": { "type": "array" },
    "capabilities": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "description", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "status": { "enum": ["available", "limited", "planned", "unverified"] }
        }
      }
    },
    "products": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "summary", "status", "capabilityIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "status": { "enum": ["available", "limited", "planned", "unverified"] },
          "capabilityIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
